{
  "version": "1.0",
  "taxonomy": {
    "types": ["Disponibilité", "Performance", "Qualité"],
    "categories": [
      { "label": "Panne", "type": "Disponibilité", "sub": ["Mécanique", "Électrique", "Capteur", "Logiciel"] },
      { "label": "Réglage", "type": "Disponibilité", "sub": ["Démarrage", "Changement format", "Calage"] },
      { "label": "Micro-arrêt", "type": "Performance", "sub": ["Blocage court", "Vidage convoyeur"] },
      { "label": "Vitesse réduite", "type": "Performance", "sub": ["Matière", "Process", "Organisation"] },
      { "label": "Défaut en cours", "type": "Qualité", "sub": ["Impression", "Contamination", "Déformation"] },
      { "label": "Manque article", "type": "Disponibilité", "sub": ["Composant", "Produit"] },
      { "label": "Incident environnemental", "type": "Disponibilité", "sub": ["Air", "Eau", "Électricité", "Vapeur"] }
    ],
    "causes_5m": ["Main-d'œuvre", "Méthode", "Matière", "Matériel", "Milieu"],
    "details": [
      { "code": "DET-001", "label": "Pompe doseuse bloquée", "category": "Panne", "sub": "Mécanique" },
      { "code": "DET-002", "label": "Réglage tête de sertissage", "category": "Réglage", "sub": "Changement format" },
      { "code": "DET-003", "label": "Manque étiquette", "category": "Manque article", "sub": "Composant" }
    ]
  },
  "fields": {
    "equipement": { "label": "Équipement", "type": "select", "source": "equipements" },
    "sous_ensemble": { "label": "Sous-ensemble", "type": "select", "source": "sous_ensembles", "depends_on": "equipement" },
    "article": { "label": "Article", "type": "select", "source": "articles" },
    "lot": { "label": "Lot", "type": "text" },
    "type_defaut": { "label": "Type de défaut", "type": "select", "source": "defauts" },
    "raison_cadence": { "label": "Raison cadence", "type": "textarea" },
    "zone": { "label": "Zone", "type": "select", "source": "zones" },
    "utilite": { "label": "Utilité", "type": "select", "source": "utilities" }
  },
  "rules": [
    { "when": { "categorie_in": ["Panne", "Réglage"] }, "requires": ["equipement", "sous_ensemble"] },
    { "when": { "cause_5m": "Matériel" }, "requires": ["equipement", "sous_ensemble"] },
    { "when": { "categorie": "Manque article" }, "requires": ["article", "lot"] },
    { "when": { "categorie": "Défaut en cours" }, "requires": ["article", "type_defaut"], "optional": ["lot"] },
    { "when": { "categorie": "Vitesse réduite" }, "requires": ["raison_cadence"] },
    { "when": { "categorie": "Incident environnemental" }, "requires": ["zone", "utilite"] }
  ],
  "lists": {
    "equipements": ["Remplisseuse", "Mirage", "Conditionneuse"],
    "sous_ensembles": {
      "Remplisseuse": ["Pompe", "Aiguille", "Vis sans fin"],
      "Mirage": ["Caméra", "Convoyeur", "Éjecteur"],
      "Conditionneuse": ["Étiqueteuse", "Scellage", "Alimenteur"]
    },
    "articles": ["Flacon", "Bouchon", "Étiquette", "Étui"],
    "defauts": ["Déformation", "Impression", "Contamination"],
    "zones": ["Remplissage", "Mirage", "Conditionnement"],
    "utilities": ["Air", "Eau", "Vapeur", "Électricité"]
  },
  "export": {
    "filename_pattern": "{LIGNE}_{DATE}",
    "columns": ["date_heure", "type", "categorie", "cause_5m", "detail_code", "detail_label", "equipement", "sous_ensemble", "article", "lot", "type_defaut", "raison_cadence", "zone", "utilite", "duree_min", "impact_qty", "commentaire"]
  },
  "ui": { "generate_event_code": true, "event_code_pattern": "{TYPE}-{EQ}-{SUB}-{NN}" }
}
